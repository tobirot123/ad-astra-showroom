# --- App ---
# Secreto para la cookie de sesión del modo demo. En producción definilo siempre.
DEMO_AUTH_SECRET=cambialo-por-un-secreto-largo

# --- Supabase ---
# Si estas tres variables están definidas, la app deja el archivo local
# (.data/db.json) y usa Postgres. Con `supabase start`, copiá los valores
# que imprime la CLI (API URL, anon key y service_role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del showroom (links de los mails y de la vista previa).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (opcional) ---
# Sin esta clave, los avisos quedan en el panel (campana) y en la bandeja
# interna. Con Resend, además se envían por email.
RESEND_API_KEY=
EMAIL_FROM=Ad Astra <avisos@example.com>

# --- Tokko (opcional, también se configura por proyecto en el panel) ---
# La API key del proyecto se guarda en la base. No la pongas en el cliente.
